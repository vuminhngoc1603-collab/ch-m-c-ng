# PostgreSQL (Supabase / Neon / local). DIRECT_URL dùng cho migrate (có thể trùng DATABASE_URL).
DATABASE_URL="postgresql://app:app@localhost:5432/chamcong"
DIRECT_URL="postgresql://app:app@localhost:5432/chamcong"

# Auth.js – tạo bằng: npx auth secret
AUTH_SECRET=""
# Google OAuth Client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (cách nhau bởi dấu phẩy) tự động thành admin khi đăng nhập lần đầu
ADMIN_EMAILS="ban@gmail.com"
# (Tuỳ chọn) chỉ cho phép đăng nhập email thuộc các domain này, vd: "congty.vn,gmail.com"
ALLOWED_EMAIL_DOMAINS=""

# Bí mật cho endpoint job quét: GET /api/cron với header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
